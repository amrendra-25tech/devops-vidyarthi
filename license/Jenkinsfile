pipeline {
    agent any

    environment {
        APP_REPO_URL = 'https://github.com/OT-MICROSERVICES/salary-api.git'
        APP_BRANCH   = 'main'
        REPORT_NAME  = 'salary-api-license-report.json'
    }

    stages {
        stage('Checkout Target Code') {
            steps {
                echo "Cloning salary-api repository from ${env.APP_REPO_URL}..."
                
                dir('salary-api') {
                    git branch: env.APP_BRANCH,
                        url: env.APP_REPO_URL
                }
            }
        }

        stage('License Scanning (Syft)') {
            steps {
                echo 'Running Anchore Syft License Scanner (Offline, Zero Rate-Limits)...'
                sh '''
                    # 1. Download Anchore Syft standalone binary if not present
                    if [ ! -f ./syft ]; then
                        echo "Installing latest Syft CLI..."
                        curl -sSfL https://raw.githubusercontent.com/anchore/syft/main/install.sh | sh -s -- -b .
                        chmod +x ./syft
                    fi

                    # Verify version
                    ./syft --version

                    # 2. Display package and dependency table in Jenkins Console
                    echo "================ DEPENDENCY & COMPONENT SUMMARY ================"
                    ./syft scan dir:salary-api -o table

                    # 3. Generate detailed SPDX License & SBOM JSON Report
                    echo "================ GENERATING LICENSE SBOM REPORT ================"
                    ./syft scan dir:salary-api -o spdx-json > "salary-api/${REPORT_NAME}"
                '''
            }
        }
    }

    post {
        always {
            // Save the SPDX license report under Jenkins build artifacts
            archiveArtifacts artifacts: "salary-api/${env.REPORT_NAME}", allowEmptyArchive: true
            echo "Archived SPDX license report: salary-api/${env.REPORT_NAME}"
        }
        success {
            echo "LICENSE SCAN PASSED: Open-source licenses and dependencies cataloged successfully!"
        }
        failure {
            echo "LICENSE SCAN FAILED: Error occurred during Syft scan."
        }
    }
}
